# M0 verification environment template.
# Copy to .env and fill in real values. NEVER commit .env (already git-ignored).
# This file must never contain real secrets.

# ---- LLM: primary (OpenRouter Space Bunny Alpha) ----
LLM_PRIMARY_PROVIDER=openrouter
LLM_PRIMARY_MODEL=stealth/space-bunny-alpha
LLM_PRIMARY_BASE_URL=https://openrouter.ai/api/v1
LLM_PRIMARY_API_KEY=

# ---- LLM: fallback (Baseten DeepSeek V4.1 Flash) ----
LLM_FALLBACK_PROVIDER=baseten
LLM_FALLBACK_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
LLM_FALLBACK_BASE_URL=https://inference.baseten.co/v1
LLM_FALLBACK_API_KEY=

# ---- LLM: control knobs (tuned during M0 runtime tests) ----
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES_PRIMARY=1
LLM_REQUIRE_STRUCTURED=true

# ---- Hindsight memory service ----
HINDSIGHT_URL=http://localhost:8888
HINDSIGHT_BANK_ID=debugagent
HINDSIGHT_API_KEY=
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=gpt-5-mini
HINDSIGHT_API_LLM_API_KEY=
